# Enforce LF line endings for all text files in this repository.
* text=auto eol=lf

# Explicitly mark key file types
*.py   text eol=lf
*.pyi  text eol=lf
*.proto text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.gz   binary
*.zip  binary
*.whl  binary
