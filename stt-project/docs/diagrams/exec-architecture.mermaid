flowchart LR
    CLIENT["Anashim"]
    API["API Service"]
    STORAGE["Storage"]
    INFERENCE["Inference Layer"]
    LLM["LLM Summarization"]
    ORCHESTRATOR["Orchestrator Layer"]

    CLIENT --> API
    API --> STORAGE
    API --> ORCHESTRATOR
    INFERENCE <--> ORCHESTRATOR
    ORCHESTRATOR <--> LLM
    ORCHESTRATOR --> API

